rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // FUNCIONES HELPER GLOBALES DE SEGURIDAD Y CONTROL DE ACCESO (RBAC)
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verifica si el usuario autenticado es superadministrador del sistema
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@venematic.com' ||
        request.auth.token.role == 'superadmin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner')
      );
    }

    // Verifica si el usuario pertenece o es dueño de la tienda especificada
    function isStoreMember(storeId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         storeId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.storeIds) ||
        (exists(/databases/$(database)/documents/stores/$(storeId)) &&
         get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid)
      );
    }

    // =========================================================================
    // 1. TIENDAS / SUCURSALES (stores)
    // =========================================================================
    match /stores/{storeId} {
      // Lectura pública permitida para que el catálogo web / marketplace funcione
      allow read: if true;

      // Creación: Solo usuarios autenticados definiéndose como dueños
      allow create: if isAuthenticated() &&
                    request.resource.data.ownerId == request.auth.uid &&
                    request.resource.data.name is string &&
                    request.resource.data.name.size() > 0 &&
                    request.resource.data.name.size() <= 100;

      // Actualización: Dueño de la tienda o superadministrador
      allow update: if isStoreMember(storeId) &&
                    request.resource.data.ownerId == resource.data.ownerId;

      // Eliminación restringida
      allow delete: if isSuperAdmin();

      // =======================================================================
      // 2. PRODUCTOS (stores/{storeId}/products/{productId})
      // =======================================================================
      match /products/{productId} {
        // Lectura pública para que clientes vean precios y catálogo en línea
        allow read: if true;

        // Escritura/Actualización: Personal autorizado de la tienda
        allow create: if isStoreMember(storeId) &&
                      request.resource.data.name is string &&
                      request.resource.data.name.size() > 0 &&
                      request.resource.data.priceUSD is number &&
                      request.resource.data.priceUSD >= 0 &&
                      request.resource.data.stock is number;

        allow update: if isStoreMember(storeId) &&
                      request.resource.data.priceUSD is number &&
                      request.resource.data.priceUSD >= 0 &&
                      request.resource.data.stock is number;

        allow delete: if isStoreMember(storeId);
      }

      // =======================================================================
      // 3. CATEGORÍAS (stores/{storeId}/categories/{categoryId})
      // =======================================================================
      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isStoreMember(storeId);
      }

      // =======================================================================
      // 4. VENTAS Y FACTURACIÓN (stores/{storeId}/sales/{saleId})
      // =======================================================================
      match /sales/{saleId} {
        // Solo el personal de la tienda puede auditar el historial de ventas
        allow read: if isStoreMember(storeId);

        // Creación: Ventas emitidas por la caja o sincronizadas offline
        allow create: if isStoreMember(storeId) &&
                      request.resource.data.receiptNumber is string &&
                      request.resource.data.totalUSD is number &&
                      request.resource.data.totalUSD >= 0 &&
                      request.resource.data.items is list &&
                      request.resource.data.items.size() > 0;

        // Las ventas son inmutables para evitar fraude. Solo se permite actualizar estado a anulada
        allow update: if isStoreMember(storeId) &&
                      resource.data.status == 'completed' &&
                      request.resource.data.status in ['cancelled', 'refunded'] &&
                      request.resource.data.receiptNumber == resource.data.receiptNumber &&
                      request.resource.data.totalUSD == resource.data.totalUSD;

        // No se permite borrar ventas (auditoría fiscal y kardex)
        allow delete: if false;
      }

      // =======================================================================
      // 5. CLIENTES (stores/{storeId}/customers/{customerId})
      // =======================================================================
      match /customers/{customerId} {
        allow read: if isStoreMember(storeId);
        allow write: if isStoreMember(storeId);
      }

      // =======================================================================
      // 6. CIERRES DE CAJA (stores/{storeId}/cash_closures/{closureId})
      // =======================================================================
      match /cash_closures/{closureId} {
        allow read: if isStoreMember(storeId);
        allow create: if isStoreMember(storeId);
        allow update, delete: if isSuperAdmin();
      }

      // =======================================================================
      // 7. REGISTRO DE KARDEX / AUDITORÍA DE INVENTARIO (inventory_logs)
      // =======================================================================
      match /inventory_logs/{logId} {
        allow read: if isStoreMember(storeId);
        allow create: if isStoreMember(storeId);
        allow update, delete: if false; // Append-only inmutable
      }

      // =======================================================================
      // 8. VALES DE CRÉDITO (credit_vouchers)
      // =======================================================================
      match /credit_vouchers/{voucherId} {
        allow read: if isStoreMember(storeId);
        allow write: if isStoreMember(storeId);
      }
    }

    // =========================================================================
    // 9. PERFILES DE USUARIOS (users/{userId})
    // =========================================================================
    match /users/{userId} {
      allow read: if isUser(userId) || isSuperAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if (isUser(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'storeIds'])) ||
                    isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 10. PEDIDOS DE DELIVERY / MARKETPLACE (marketplace_orders)
    // =========================================================================
    match /marketplace_orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        isStoreMember(resource.data.storeId) ||
        resource.data.riderId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        isStoreMember(resource.data.storeId) ||
        resource.data.riderId == request.auth.uid
      );
    }
  }
}
