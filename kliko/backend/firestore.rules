rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isRole(r) {
      return isAuthenticated() && getUserRole() == r;
    }

    // Wallets: Strictly private. Only owner or master admin can read. Writes handled by Cloud Functions.
    match /wallets/{walletId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isRole('admin'));
      allow write: if isRole('admin'); 
    }

    match /token_transactions/{txId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isRole('admin'));
      allow write: if false; // Solo ledger auditado por backend
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.merchantId == request.auth.uid ||
        resource.data.riderId == request.auth.uid ||
        isRole('admin')
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isRole('admin') ||
        resource.data.merchantId == request.auth.uid ||
        resource.data.riderId == request.auth.uid
      );
    }

    match /merchants/{merchantId} {
      allow read: if true;
      allow write: if isRole('admin') || (isAuthenticated() && request.auth.uid == merchantId);
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isRole('admin') || isRole('merchant');
    }
  }
}
